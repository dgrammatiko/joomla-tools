{
  "name": "@dgrammatiko/joomla-tools",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Tools for developing J4 extensions",
  "bin": {
    "joomla-tools": "joomla-tools.mjs"
  },
  "type": "module",
  "exports": "./joomla-tools.mjs",
  "scripts": {
    "i": "node joomla-tools.mjs -i",
    "l": "node joomla-tools.mjs -l",
    "b": "node joomla-tools.mjs -b media_src",
    "r": "node joomla-tools.mjs -r",
    "w": "node joomla-tools.mjs -w",
    "init": "npm run i && npm run l && npm run b",
    "lint-css": "stylelint test/stubs/css/.",
    "lint-js": "eslint **/*.mjs",
    "lint": "npm run lint-css && npm run lint-js",
    "update:browserlist": "npx browserslist@latest --update-db",
    "prepub": "npx np --no-cleanup --yolo --no-publish",
    "update": "npm install $(npm outdated | cut -d' ' -f 1 | sed '1d' | xargs -I '$' echo '$@latest' | xargs echo)  --save-exact",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "coverage": "mkdir -p coverage && node --test --test-concurrency=1 --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.mjs",
    "release:major": "npm version $(semver $npm_package_version -i major) && npm publish --tag latest",
    "release:minor": "npm version $(semver $npm_package_version -i minor) && npm publish --tag latest",
    "release:patch": "npm version $(semver $npm_package_version -i patch) && npm publish --tag latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgrammatiko/joomla-tools.git"
  },
  "keywords": [
    "Joomla",
    "scaffolding",
    "components",
    "modules",
    "plugins",
    "libraries",
    "templates",
    "esm",
    "es5",
    "transpilling",
    "scss",
    "postcss"
  ],
  "author": "Dimitris Grammatikogiannis",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dgrammatiko/joomla-tools/issues"
  },
  "homepage": "https://github.com/dgrammatiko/joomla-tools#readme",
  "dependencies": {
    "adm-zip": "0.6.1",
    "autoprefixer": "10.7.1",
    "chokidar": "6.0.0",
    "commander": "15.1.0",
    "cssnano": "9.9.0",
    "eslint": "10.16.0",
    "eslint-plugin-vue": "10.12.1",
    "postcss": "8.5.34",
    "postcss-cli": "12.0.0",
    "postcss-custom-media": "12.0.4",
    "postcss-custom-selectors": "9.0.5",
    "postcss-discard-comments": "9.0.8",
    "postcss-easy-import": "^4.0.0",
    "postcss-mixins": "12.1.2",
    "postcss-nested": "9.0.1",
    "postcss-preset-env": "11.6.3",
    "postcss-scss": "4.0.9",
    "rolldown": "1.3.4",
    "rtlcss": "4.4.0",
    "sass": "1.108.2",
    "semver": "7.8.6",
    "stylelint": "18.1.0",
    "stylelint-config-recommended": "19.1.0",
    "stylelint-config-standard": "41.1.0",
    "stylelint-order": "8.1.3",
    "stylelint-scss": "7.5.0",
    "symlink-dir": "10.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
